# dependencies
/node_modules
/.pnp
.pnp.js

# JetBrains IDE files
.idea/

# testing
/coverage

# gatsby (apps/blog 빌드 산출물. blog-next 의 public/ 은 정적 자산 소스라 추적한다)
.cache/
apps/blog/public/

# production
/build

# misc
.DS_Store
*.pem
tsconfig.tsbuildinfo

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env\*

# vercel
.vercel

# Yarn berry
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/versions

# playwright mcp (브라우저 자동화 스냅샷·콘솔 로그 출력물)
.playwright-mcp/
